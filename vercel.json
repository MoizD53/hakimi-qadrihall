{
  "version": 2,
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/pay.html",
      "destination": "/login",
      "permanent": false
    },
    {
      "source": "/pay",
      "destination": "/login",
      "permanent": false
    },
    {
      "source": "/backend/(.*)",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/local.db",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/admin.html"
    },
    {
      "source": "/",
      "destination": "/login.html"
    }
  ]
}
