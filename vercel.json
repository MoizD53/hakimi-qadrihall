{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/admin.html",
      "destination": "/admin",
      "permanent": true
    },
    {
      "source": "/pay.html",
      "destination": "/pay",
      "permanent": true
    },
    {
      "source": "/backend/(.*)",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/local.db",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin.html"
    },
    {
      "source": "/pay",
      "destination": "/pay.html"
    },
    {
      "source": "/pay/",
      "destination": "/pay.html"
    }
  ],
  "functions": {
    "api/*.js": {
      "includeFiles": "{assets/**,public/**}"
    }
  }
}
