# Evan-e-Hakimi & Evan-e-Qadri Banquet Halls — Vercel Environment Variables Template
# Set these variables in your Vercel Project Settings (Settings -> Environment Variables)
# Or copy this file to .env for local development. NEVER commit .env to git.

# ── Database (Turso / libSQL) ──
# For Turso Cloud (Production):
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# For Local Development with SQLite file (Optional fallback):
# TURSO_DATABASE_URL=file:local.db

# ── Server ──
PORT=5000
NODE_ENV=production

# ── Admin Credentials (validated server-side only) ──
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_strong_admin_password_here

# ── JWT Secret (used for signing admin sessions) ──
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_64_char_random_hex_secret_here

# ── CORS / Custom Domain (Optional) ──
# The server dynamically accepts same-origin and *.vercel.app preview URLs.
# You can optionally set your custom domain here:
ALLOWED_ORIGIN=https://your-custom-domain.com
